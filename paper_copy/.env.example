# --- zorunlu ---
HELIUS_API_KEY=buraya_helius_anahtari
# Telegram: mevcut botunun token'ını ve sohbet ID'sini kullanabilirsin (sadece mesaj gönderir, komut dinlemez)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- isteğe bağlı (varsayılanlar) ---
DELAYS_SEC=1,3,30          # kopyalama gecikmeleri (saniye), hepsi paralel test edilir
PAPER_SIZE_SOL=0.5         # sanal işlem büyüklüğü
FEE_PER_SIDE=0.015         # tek yön ücret + kayma tahmini (%1,5)
MIN_SIGNAL_SOL=0.2         # takip edilen cüzdanın bundan küçük alımlarını yok say
EXIT_SOLD_FRACTION=0.5     # cüzdan pozisyonunun bu kadarını satınca çık
MAX_HOLD_HOURS=48          # bu süreden sonra zorla çık
FALLBACK_POLL_SEC=900      # websocket'in kaçırdıkları için yedek tarama aralığı
NOTIFY_SIGNALS=1           # 1 = cüzdan aldığında da bildir, 0 = sadece sonuçlar
DAILY_REPORT_HOUR=21       # günlük rapor saati (İstanbul)
