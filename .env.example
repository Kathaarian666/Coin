# Bu dosyayı .env olarak kopyalayın ve doldurun. .env GitHub'a GÖNDERİLMEZ.

# @BotFather'dan aldığınız token
TELEGRAM_BOT_TOKEN=
# Bildirim alacak sohbet ID'leri (virgülle). Botta /start yazınca ID'nizi söyler.
TELEGRAM_CHAT_IDS=

# Robinhood Chain (varsayılanlar ücretsiz public servislerdir)
RPC_URL=https://rpc.mainnet.chain.robinhood.com
BLOCKSCOUT_URL=https://robinhoodchain.blockscout.com
WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
# Sadece bu factory/PoolManager adreslerinden gelen havuzları kabul et (boş = hepsi)
FACTORY_ALLOWLIST=
# WETH dışındaki quote token'lar (ör. stablecoin adresleri, virgülle)
EXTRA_QUOTE_TOKENS=

# Bildirim filtresi: bu skorun altındakiler bildirilmez (botta /minskor ile de değişir)
MIN_SCORE_ALERT=50

# Fomo takibi: FOMO_WINDOW_MIN dakikada en az FOMO_MIN_BUYERS farklı Fomo kullanıcısı
# bir coini alınca ve Fomo alım hacmi en az FOMO_MIN_BUY_USD olunca analiz edilir
# (botta /minalici ve /minhacim ile de değişir).
ENABLE_FOMO_WATCHER=1
FOMO_WINDOW_MIN=10
FOMO_MIN_BUYERS=10
FOMO_MIN_BUY_USD=500
FOMO_LOOKBACK_BLOCKS=6000
# Fomo'dan bağımsız olarak açılan HER yeni havuz (çok gürültülü, varsayılan kapalı)
ENABLE_POOL_WATCHER=0

# İnce ayarlar
POLL_INTERVAL=3
RPC_MAX_RPS=6
ANALYSIS_DELAY=8
ANALYSIS_WORKERS=2
PROBE_ETH=0.005
START_LOOKBACK_BLOCKS=0
USE_DEXSCREENER=1
V4_POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951
HOLDER_LOOKBACK_BLOCKS=30000000
DB_PATH=rhscanner.db
